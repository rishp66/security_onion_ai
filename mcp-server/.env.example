# Copy to .env and fill in. NEVER commit the real .env.
# Create a read-only ES role/user in Security Onion for this - do not use the
# built-in admin/elastic credentials here (guardrail 1: read-only ES user).

ES_URL=https://10.0.1.10:9200
ES_USER=mcp_readonly
ES_PASSWORD=changeme
# Path to SO's self-signed CA cert (pull via scp from the SO manager), OR set
# ES_VERIFY_CERTS=false for lab-only convenience (not for anything else).
ES_CA_CERT=
ES_VERIFY_CERTS=true
